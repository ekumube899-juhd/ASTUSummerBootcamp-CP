t = int(input())
for _ in range(t):
    n = int(input())
    grid = []
    used = set()
    for i in range(n):
        row = list(map(int, input(). split()))
        grid.append(row)
        for a in row:
            used.add(a)
    ans = []
    for j in range(n):
        ans.append(grid[0][j])
    for i in range(1, n):
        ans.append(grid[i][n - 1])
    for a in range(1, 2 * n + 1):
        if a not in used:
            ans.insert(0, a)
            break
    print(*ans)
