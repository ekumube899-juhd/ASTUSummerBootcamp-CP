class Solution:
    def reverseOnlyLetters(self, s: str) -> str:
        letters = []
        for ch in s:
            if ch.isalpha():
                letters.append(ch)
        letters.reverse()
        result = ""
        i = 0
        for ch in s:
            if ch.isalpha():
                result += letters[i]
                i += 1
            else:
                result += ch
        return result        
